# Comma-separated CORS origins. Set to your Vercel URL(s) in production.
# Local dev default (used when unset): http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Filesystem path for the audio cache. In Docker/Railway this should point
# at the mounted volume (default /data/cache). Locally it can be any writable path.
CACHE_DIR=/data/cache

# Port uvicorn binds to. Railway injects PORT automatically; keep 8000 for local.
PORT=8000

# NOTE: All provider credentials are BYOK — never server-side env vars.
# The browser sends them per-request as HTTP headers; the backend forwards
# them to the provider and never persists or logs them.
#
#   X-Fish-Key             — always required (all TTS synthesis)
#   X-OpenAI-Key           — required only for Mandarin (segmentation)
#   X-Azure-Speech-Key     — required only for pronunciation scoring
#   X-Azure-Speech-Region  — required only for pronunciation scoring
#                            (Azure region slug, e.g. westus, eastus, westeurope)
#
# Azure pronunciation is strict opt-in: omit either header and /shadow/analyze
# still returns prosody (pace-match) with pronunciation: null.
